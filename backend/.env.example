# OpenRouter API Credentials
# Replace with your actual OpenRouter API key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default Models (Change as desired)
DEFAULT_CANDIDATE_MODEL=google/gemini-2.5-flash
DEFAULT_JUDGE_MODEL=google/gemini-2.5-pro

# Secret key for JWT signing (not needed in guest mode, but kept for full stack)
JWT_SECRET_KEY=supersecretkeychangeinproduction1234567890!
